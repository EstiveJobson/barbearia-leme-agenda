# Neon Postgres connection string. Required in production; local dev uses embedded PGLite when unset.
DATABASE_URL=
# Plain password hashed into owner_accounts at seed time. Never commit a real value.
ADMIN_PASSWORD=
# Secret used to sign the owner panel session cookie (httpOnly, 30 days). Server-only. Required to log in at /painel.
SESSION_SECRET=
# Resend API key. Server-only. Each saved booking emails NOTIFY_EMAIL_TO. If any of the three email variables are empty, the email is skipped.
RESEND_API_KEY=
# From address for that email, e.g. agenda@example.com or Barbearia Leme <agenda@example.com>.
EMAIL_FROM=
# Inbox that receives new-booking notifications.
NOTIFY_EMAIL_TO=
# Shared secret required on scheduled job requests. Server-only.
CRON_SECRET=
# Set to true on the public demonstration deployment.
DEMO_MODE=
# Public origin with no trailing slash. Used for og:image, og:url, and the /painel link in the booking email.
PUBLIC_SITE_URL=
# Web Push VAPID public key (safe to expose to the browser). The panel hides "Ativar avisos" unless both VAPID keys are set.
VAPID_PUBLIC_KEY=
# Web Push VAPID private key. Server-only. Never sent to the browser.
VAPID_PRIVATE_KEY=
